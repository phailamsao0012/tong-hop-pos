{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tong-hop-pos",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Giữ địa chỉ workers.dev cũ chạy song song với tên miền riêng (Cloudflare tự tắt khi có custom domain).
  "workers_dev": true,
  // Tên miền riêng (zone trên cùng tài khoản Cloudflare); workers.dev vẫn chạy song song.
  "routes": [
    { "pattern": "tonghopposmegatech.io.vn", "custom_domain": true },
    { "pattern": "www.tonghopposmegatech.io.vn", "custom_domain": true }
  ],
  // Mỗi phút: Chia số (thử nghiệm, lib/dispatch.ts). Đồng bộ Pancake POS vẫn mỗi 5 phút (worker.ts lọc theo phút).
  "triggers": { "crons": ["* * * * *"] },
  // Bộ hẹn giờ đồng bộ (Durable Object alarm), xem lib/scheduler.ts.
  "durable_objects": { "bindings": [{ "name": "SYNC_SCHEDULER", "class_name": "SyncScheduler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncScheduler"] }],
  // Workers AI (gói miễn phí 10.000 neurons/ngày): tóm tắt sáng trên màn Điều hành, xem lib/ai-summary.ts.
  "ai": { "binding": "AI" },
  // Gọi web nhân sự (Worker megatech-crm) nội bộ: kéo dữ liệu nhân sự. Hai Worker cùng tên miền không gọi nhau qua URL công khai được.
  "services": [{ "binding": "HR", "service": "megatech-crm" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tong-hop-pos",
      "database_id": "66c5b8d5-6a45-48b3-a7ef-76ab4c4416b4",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    // Múi giờ dùng cho báo cáo theo ngày.
    "REPORT_TIMEZONE": "Asia/Ho_Chi_Minh",
    // Địa chỉ gửi OTP, phải là sender đã xác minh trên Brevo (khóa BREVO_API_KEY là secret trên Cloudflare).
    "MAIL_FROM": "vuvanvu1189@gmail.com",
    // Web vệ tinh nhân sự (repo megatech-crm); bí mật liên kết HR_SHARED_SECRET đặt bằng wrangler secret.
    "CRM_URL": "https://crm.tonghopposmegatech.io.vn"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tong-hop-pos",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Giữ địa chỉ workers.dev cũ chạy song song với tên miền riêng (Cloudflare tự tắt khi có custom domain).
  "workers_dev": true,
  // Tên miền riêng (zone trên cùng tài khoản Cloudflare); workers.dev vẫn chạy song song.
  "routes": [
    { "pattern": "tonghopposmegatech.io.vn", "custom_domain": true },
    { "pattern": "www.tonghopposmegatech.io.vn", "custom_domain": true }
  ],
  // Tự đồng bộ Pancake POS mỗi 5 phút, không cần mở web.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Bộ hẹn giờ đồng bộ (Durable Object alarm), xem lib/scheduler.ts.
  "durable_objects": { "bindings": [{ "name": "SYNC_SCHEDULER", "class_name": "SyncScheduler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncScheduler"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tong-hop-pos",
      "database_id": "66c5b8d5-6a45-48b3-a7ef-76ab4c4416b4",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    // Múi giờ dùng cho báo cáo theo ngày.
    "REPORT_TIMEZONE": "Asia/Ho_Chi_Minh",
    // Địa chỉ gửi OTP, phải là sender đã xác minh trên Brevo (khóa BREVO_API_KEY là secret trên Cloudflare).
    "MAIL_FROM": "vuvanvu1189@gmail.com"
  }
}
